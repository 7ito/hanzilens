# Environment variables for HanziLens backend
# Copy to .env and fill in values

# Server port (default: 5000)
PORT=5000

# OpenRouter API - required for /parse endpoint
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use for text parsing. Recommended: google/gemini-2.5-flash-lite-preview-09-2025
# See all models at: https://openrouter.ai/models
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=2500

# Google Cloud Vision - required for image OCR endpoints
# Configure ONE of these. API key is the simplest for local dev.
# Restrict the API key to Cloud Vision API in Google Cloud Console.
GOOGLE_CLOUD_VISION_API_KEY=

# Optional alternatives to API key auth
# GOOGLE_CLOUD_VISION_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Trust proxy setting for correct client IP detection (affects rate limiting)
# Set to number of proxy hops (e.g., 1 for single reverse proxy like Caddy)
# Set to "true" to trust all proxies
# Leave unset if running without a reverse proxy
# TRUST_PROXY=1

# Redis-backed rate limit store. Required when NODE_ENV=production.
# REDIS_URL=redis://localhost:6379

# Backend analytics. Disabled unless ANALYTICS_ENABLED=true.
# Events contain hashes only, never raw client IDs, IPs, text, tokens, or image data.
ANALYTICS_ENABLED=false
ANALYTICS_POSTHOG_KEY=
ANALYTICS_POSTHOG_HOST=https://app.posthog.com
ANALYTICS_HASH_SECRET=

# Global usage switch for all nonzero limits below.
# Examples: 0.5 halves all usage limits, 2 doubles all usage limits.
RATE_LIMIT_USAGE_MULTIPLIER=1

# Public launch defaults. Set a global daily limit to 0 to disable that global cap.
RATE_LIMIT_PARSE_CLIENT_PER_MINUTE=30
RATE_LIMIT_PARSE_CLIENT_PER_HOUR=180
RATE_LIMIT_PARSE_CLIENT_PER_DAY=500
RATE_LIMIT_PARSE_IP_PER_MINUTE=60
RATE_LIMIT_PARSE_IP_PER_HOUR=1000
RATE_LIMIT_PARSE_IP_PER_DAY=3000
RATE_LIMIT_PARSE_GLOBAL_PER_DAY=5000
RATE_LIMIT_ABUSE_PARSE_IP_PER_MINUTE=120
RATE_LIMIT_ABUSE_PARSE_IP_PER_HOUR=3000

RATE_LIMIT_OCR_CLIENT_PER_MINUTE=3
RATE_LIMIT_OCR_CLIENT_PER_HOUR=20
RATE_LIMIT_OCR_CLIENT_PER_DAY=30
RATE_LIMIT_OCR_IP_PER_MINUTE=10
RATE_LIMIT_OCR_IP_PER_HOUR=100
RATE_LIMIT_OCR_IP_PER_DAY=300
RATE_LIMIT_OCR_GLOBAL_PER_DAY=500
RATE_LIMIT_ABUSE_OCR_IP_PER_MINUTE=30
RATE_LIMIT_ABUSE_OCR_IP_PER_HOUR=600

RATE_LIMIT_LOOKUP_CLIENT_PER_MINUTE=120
RATE_LIMIT_LOOKUP_CLIENT_PER_DAY=2000
RATE_LIMIT_LOOKUP_IP_PER_MINUTE=600
RATE_LIMIT_LOOKUP_IP_PER_DAY=10000
RATE_LIMIT_EVAL_IP_PER_MINUTE=10

# Enable eval endpoint for model benchmarking (default: disabled)
# WARNING: This endpoint has no authentication and allows arbitrary model overrides
# ENABLE_EVAL=true
